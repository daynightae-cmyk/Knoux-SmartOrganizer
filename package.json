{
  "name": "knoux-smartorganizer",
  "version": "0.4.0",
  "description": "KNOuX SmartOrganizer — private, local-first Windows utility",
  "private": true,
  "author": "Knoux Technologies",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "vite build",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "smoke:packaged-operations": "node scripts/packaged-operations-smoke.cjs",
    "smoke:installer": "node scripts/installer-smoke.cjs",
    "smoke:offline": "node scripts/offline-smoke.cjs",
    "verify:release": "npm run check && npm run lint && npm run test && npm run build && npm run desktop:pack && node scripts/verify-release.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "^3.5.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.2",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "com.knoux.smartorganizer",
    "productName": "KNOuX SmartOrganizer",
    "copyright": "Copyright © 2026 Knoux Technologies",
    "icon": "build/icon.ico",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "shared/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KNOuX SmartOrganizer",
      "artifactName": "KNOuX-SmartOrganizer-Setup-x64.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
